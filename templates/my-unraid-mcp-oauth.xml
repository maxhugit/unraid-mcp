<?xml version="1.0"?>
<Container version="2">
  <Name>unraid-mcp-oauth</Name>
  <Repository>ghcr.io/maxhugit/unraid-mcp-oauth:latest</Repository>
  <Registry>https://github.com/maxhugit/unraid-mcp/pkgs/container/unraid-mcp-oauth</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/maxhugit/unraid-mcp/issues</Support>
  <Project>https://github.com/maxhugit/unraid-mcp</Project>
  <Overview>Passerelle OAuth FastMCP protégeant le serveur Unraid MCP avec un fournisseur OpenID Connect.</Overview>
  <Category>Tools:Utilities Network:Management Security:</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/maxhugit/unraid-mcp/main/templates/my-unraid-mcp-oauth.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/IDmedia/hass-unraid/main/extras/logo.png</Icon>
  <ExtraParams>--read-only --cap-drop=ALL --security-opt=no-new-privileges:true --memory=512m --pids-limit=128 --tmpfs=/tmp:rw,noexec,nosuid,size=32m</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>Créez gateway.json et le dossier oauth-state dans /mnt/user/appdata/unraid-mcp avant le premier démarrage.</Requires>
  <Config Name="Configuration OAuth" Target="/run/config/gateway.json" Default="/mnt/user/appdata/unraid-mcp/gateway.json" Mode="ro" Description="Configuration privée OAuth montée en lecture seule." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/unraid-mcp/gateway.json</Config>
  <Config Name="État OAuth persistant" Target="/home/mcp/.local/share" Default="/mnt/user/appdata/unraid-mcp/oauth-state" Mode="rw" Description="Sessions OAuth persistantes." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/unraid-mcp/oauth-state</Config>
  <TailscaleStateDir/>
</Container>
